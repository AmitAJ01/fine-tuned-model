# ==============================================================================
# FineTuneOps — Environment Configuration Template
# Copy this file to .env and adjust variables for your local or cloud setup.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application & API Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Model & Device Configuration
# Base instruction model from Hugging Face
BASE_MODEL_NAME=Qwen/Qwen2.5-Coder-1.5B-Instruct
# Path to completion-masked QLoRA adapter checkpoint
FINETUNED_ADAPTER_PATH=models/finetuned_v2/adapter/best
# Hardware acceleration: 'cuda' (auto-detected if available) or 'cpu'
DEVICE=cuda
FORCE_CPU=0

# Hugging Face Settings
# Optional custom cache directory
# HF_HOME=./.cache/huggingface
# Offline mode (prevents external network calls when models are cached)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional Experiment Tracking (W&B / MLflow)
# WANDB_API_KEY=your-wandb-api-key-here
# WANDB_PROJECT=finetune-ops
# MLFLOW_TRACKING_URI=http://localhost:5000
